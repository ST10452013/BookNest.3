<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BookNest"
            android:textColor="#244D3B"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your next favourite book awaits."
            android:textColor="#555555"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Discover your next read"
            android:textColor="#244D3B"
            android:textSize="23sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/bookSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Enter a book title or author"
            android:inputType="text"
            android:padding="14dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/searchBooksButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#244D3B"
            android:text="Search Books"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/favouritesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#244D3B"
            android:text="My Favourites"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/readingTrackerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#244D3B"
            android:text="Reading Tracker"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/homeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Search for books to get started."
            android:textColor="#555555"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/bookResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="#777777"
            android:text="Log Out"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
